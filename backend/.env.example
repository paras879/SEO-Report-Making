# ===== Server =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seo_report
DB_USER=postgres
DB_PASSWORD=postgres

# ===== Security =====
# IMPORTANT: production me in dono ko lambi random strings se badalna
JWT_SECRET=change_this_to_a_long_random_secret_key_min_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# ===== Super Admin seed (pehli baar bootstrap) =====
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=Super@12345

# ===== Uploads =====
MAX_FILE_SIZE_MB=10
